{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "bun"
    ],
    "noEmit": true
  },
  "include": [
    "src",
    "api",
    "scripts",
    "test",
    "demo.ts"
  ]
}