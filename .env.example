# --- Almacenamiento ---
# local: disco (desarrollo y demo.ts). supabase: producción en Vercel.
STORAGE=local
# Solo local: carpeta de salida (en Vercel con STORAGE=local se usa /tmp/out)
# OUT_DIR=out

# --- Supabase (solo si STORAGE=supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=paquetes

# --- Negocio ---
# Fecha contra la que se evalúa la vigencia de los soportes (AAAA-MM-DD)
FECHA_REFERENCIA=2026-09-03
