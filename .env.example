# ===== Almacenamiento =====
# local: disco (desarrollo y demo.ts). supabase: producción en Vercel.
STORAGE=local
# Solo local: carpeta de salida (en Vercel con STORAGE=local se usa /tmp/out)
# OUT_DIR=out

# ===== Supabase (solo si STORAGE=supabase) =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=paquetes

# ===== Modelos =====
# Orden de la cadena. Se pasa al siguiente SOLO por créditos agotados, límite de velocidad o timeout.
LLM_CHAIN=openai,google,deepseek
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.1-flash-lite
# Gemini se usa por su endpoint compatible con OpenAI
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_TIMEOUT_MS=25000
# Precios USD por millón de tokens, para estimar el gasto (opcional; hay valores por defecto)
# LLM_PRICES={"gpt-4.1-mini":{"in":0.4,"out":1.6}}

# ===== Topes =====
SESSION_TOKEN_CAP=60000
MAX_ITERATIONS=25
GLOBAL_DAILY_USD_CAP=5
RATE_LIMIT_PER_MIN=20
MAX_MESSAGE_CHARS=2000

# ===== Negocio =====
# Fecha contra la que se evalúa la vigencia de los soportes (AAAA-MM-DD)
FECHA_REFERENCIA=2026-09-03

# ===== Administración =====
# Si no se define, el reset queda deshabilitado. Uso: POST /api/reset con cabecera x-reset-key
RESET_KEY=
